[Unit]
Description=Recolha de posicoes dos autocarros STCP (Porto Verde)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=recolha
WorkingDirectory=/opt/recolha
ExecStart=/usr/bin/python3 -B /opt/recolha/recolher_autocarros.py --out /var/lib/recolha --intervalo 30
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
