{
  "name": "portoverde-chat",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-27",
  "ai_search_namespaces": [{ "binding": "AI_SEARCH", "namespace": "habitacao-pt" }],
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "CONTADOR", "class_name": "Contador" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Contador"] }],
  "observability": { "enabled": false },
  "vars": { "ORIGEM_PERMITIDA": "https://portoverde.pt" }
  // Segredos (wrangler secret put): TURNSTILE_SECRET, SALT (obrigatório: sem ele o Worker recusa pedidos)
}
